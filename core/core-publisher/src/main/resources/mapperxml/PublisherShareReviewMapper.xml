<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.origin.banyu.publisher.mapper.PublisherShareReviewMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.origin.banyu.publisher.entity.PublisherShareReview">
        <id column="share_review_id" property="shareReviewId"/>
        <result column="task_id" property="taskId"/>
        <result column="share_content" property="shareContent"/>
        <result column="share_platform" property="sharePlatform"/>
        <result column="share_url" property="shareUrl"/>
        <result column="screenshot_url" property="screenshotUrl"/>
        <result column="reviewer_id" property="reviewerId"/>
        <result column="review_status_id" property="reviewStatusId"/>
        <result column="review_comment" property="reviewComment"/>
        <result column="created_time" property="createdTime"/>
        <result column="updated_time" property="updatedTime"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        share_review_id, task_id, share_content, share_platform, share_url, screenshot_url, reviewer_id, review_status_id, review_comment,
        created_time, updated_time, created_by, updated_by, deleted
    </sql>

    <!-- 根据审核状态查询分享审核列表 -->
    <select id="selectByReviewStatus" resultMap="BaseResultMap">
        SELECT 
        <include refid="Base_Column_List"/>
        FROM publisher_share_review 
        WHERE deleted = 0
        <if test="reviewStatus != null">
            AND review_status_id = #{reviewStatus}
        </if>
        ORDER BY created_time DESC
    </select>

    <!-- 多条件分页查询：taskIds / taskName / reviewStatus / userIds / wechatNickname 任意组合 -->
    <select id="selectByConditions" resultMap="BaseResultMap">
        SELECT psr.*
        FROM publisher_share_review psr
        LEFT JOIN publisher_task pt ON psr.task_id = pt.task_id
        LEFT JOIN sys_user u ON psr.created_by = u.user_id
        WHERE psr.deleted = 0
        <if test="req.taskIds != null and req.taskIds.size() > 0">
            AND psr.task_id IN
            <foreach collection="req.taskIds" item="taskId" open="(" separator="," close=")">
                #{taskId}
            </foreach>
        </if>
        <if test="req.taskName != null and req.taskName != ''">
            AND pt.task_name LIKE CONCAT('%', #{req.taskName}, '%')
        </if>
        <if test="req.reviewStatus != null">
            AND psr.review_status_id = #{req.reviewStatus}
        </if>
        <if test="req.userIds != null and req.userIds.size() > 0">
            AND psr.created_by IN
            <foreach collection="req.userIds" item="userId" open="(" separator="," close=")">
                #{userId}
            </foreach>
        </if>
        <if test="req.wechatNickname != null and req.wechatNickname != ''">
            AND u.wechat_nickname LIKE CONCAT('%', #{req.wechatNickname}, '%')
        </if>
        ORDER BY psr.created_time DESC
    </select>

    <!-- 多条件查询所有数据（不分页，用于导出）：taskIds / taskName / reviewStatus / userIds / wechatNickname 任意组合 -->
    <select id="selectAllByConditions" resultMap="BaseResultMap">
        SELECT psr.*
        FROM publisher_share_review psr
        LEFT JOIN publisher_task pt ON psr.task_id = pt.task_id
        LEFT JOIN sys_user u ON psr.created_by = u.user_id
        WHERE psr.deleted = 0
        <if test="req.taskIds != null and req.taskIds.size() > 0">
            AND psr.task_id IN
            <foreach collection="req.taskIds" item="taskId" open="(" separator="," close=")">
                #{taskId}
            </foreach>
        </if>
        <if test="req.taskName != null and req.taskName != ''">
            AND pt.task_name LIKE CONCAT('%', #{req.taskName}, '%')
        </if>
        <if test="req.reviewStatus != null">
            AND psr.review_status_id = #{req.reviewStatus}
        </if>
        <if test="req.userIds != null and req.userIds.size() > 0">
            AND psr.created_by IN
            <foreach collection="req.userIds" item="userId" open="(" separator="," close=")">
                #{userId}
            </foreach>
        </if>
        <if test="req.wechatNickname != null and req.wechatNickname != ''">
            AND u.wechat_nickname LIKE CONCAT('%', #{req.wechatNickname}, '%')
        </if>
        ORDER BY psr.created_time DESC
    </select>
    
    <!-- 根据任务ID列表批量查询 -->
    <select id="selectByTaskIds" resultMap="BaseResultMap">
        SELECT 
        <include refid="Base_Column_List"/>
        FROM publisher_share_review psr
        WHERE psr.deleted = 0
        <if test="taskIds != null and taskIds.size() > 0">
            AND psr.task_id IN
            <foreach collection="taskIds" item="taskId" open="(" separator="," close=")">
                #{taskId}
            </foreach>
        </if>
        ORDER BY psr.created_time DESC
    </select>
    
    <!-- 根据用户ID列表批量查询 -->
    <select id="selectByUserIds" resultMap="BaseResultMap">
        SELECT 
        <include refid="Base_Column_List"/>
        FROM publisher_share_review psr
        WHERE psr.deleted = 0
        <if test="userIds != null and userIds.size() > 0">
            AND psr.created_by IN
            <foreach collection="userIds" item="userId" open="(" separator="," close=")">
                #{userId}
            </foreach>
        </if>
        ORDER BY psr.created_time DESC
    </select>
    
    <!-- 统计指定条件下的记录数量 -->
    <select id="countByConditions" resultType="long">
        SELECT COUNT(*)
        FROM publisher_share_review psr
        LEFT JOIN publisher_task pt ON psr.task_id = pt.task_id
        LEFT JOIN sys_user u ON psr.created_by = u.user_id
        WHERE psr.deleted = 0
        <if test="req.taskIds != null and req.taskIds.size() > 0">
            AND psr.task_id IN
            <foreach collection="req.taskIds" item="taskId" open="(" separator="," close=")">
                #{taskId}
            </foreach>
        </if>
        <if test="req.taskName != null and req.taskName != ''">
            AND pt.task_name LIKE CONCAT('%', #{req.taskName}, '%')
        </if>
        <if test="req.reviewStatus != null">
            AND psr.review_status_id = #{req.reviewStatus}
        </if>
        <if test="req.userIds != null and req.userIds.size() > 0">
            AND psr.created_by IN
            <foreach collection="req.userIds" item="userId" open="(" separator="," close=")">
                #{userId}
            </foreach>
        </if>
        <if test="req.wechatNickname != null and req.wechatNickname != ''">
            AND u.wechat_nickname LIKE CONCAT('%', #{req.wechatNickname}, '%')
        </if>
    </select>

</mapper> 